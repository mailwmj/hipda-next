<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ data extraction rules (API >= 31) only match exact file paths or directories;
  wildcards (*) and filename prefixes (e.g. "hx_") are NOT matched by BackupAgent.
  Exclude all SharedPreferences (covers Tink keysets in hx_tink_keysets.xml and any future hx_*
  keyset prefs; new app settings live in files/datastore/settings.preferences_pb) plus every
  hx_-prefixed encrypted DataStore file explicitly for both cloud-backup and device-transfer.
  Keep in sync with backup_config.xml; BackupExclusionRulesTest enforces coverage.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="hx_tink_keysets.xml" />
        <exclude domain="file" path="datastore/hx_credentials" />
        <exclude domain="file" path="datastore/hx_site_cookies" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="hx_tink_keysets.xml" />
        <exclude domain="file" path="datastore/hx_credentials" />
        <exclude domain="file" path="datastore/hx_site_cookies" />
    </device-transfer>
</data-extraction-rules>
